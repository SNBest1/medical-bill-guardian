{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medical-bill-guardian",
  "addresses": ["ai@nipunsaini.com"],
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SPACETIME_HTTP_URL": "https://maincloud.spacetimedb.com",
    "SPACETIME_DB_NAME": "medical-bill-guardian-email",
    "EMAIL_SEND_ENABLED": "false",
    "RESEND_FROM_EMAIL": "billing@nipunsaini.com",
    "PROVIDER_REPLY_EMAIL": "nipun.saini9@gmail.com",
    "EMAIL_DAILY_LIMIT": "20",
    "BILL_PDF_ALLOWED_HOSTS": ""
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
