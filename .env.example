# Runs the complete local story without external calls.
DEMO_MODE=true
# Database file, relative to the project root.
DATABASE_PATH=./data/guardian.sqlite
# Nessie API key from Capital One's developer portal; used only with DEMO_MODE=false.
NESSIE_API_KEY=
# Customer ID in the Nessie sandbox.
NESSIE_CUSTOMER_ID=
# Nessie's HTTPS API origin; do not include a path, query, or API key.
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# FinchNode API base URL; the default is https://api.finchnode.com/api/v1.
FINCHNODE_BASE_URL=https://api.finchnode.com/api/v1
# App-scoped subject from a completed patient consent flow.
FINCHNODE_SUBJECT=
# Server-side FinchNode sandbox API key (ck_test_...). In demo mode, when set, the judge patients are read from their consented
# sandbox patient (found by persona label via GET /users) before falling back to the keyless open demo API, then the saved copy.
FINCHNODE_API_KEY=
# Relay staging agent API; used only after a live Relay adapter is implemented.
RELAY_API_URL=https://api.staging.relayapp.im
# Agent Token from Relay Console. Never use a Console login token here.
RELAY_AGENT_TOKEN=
# Verified Relay handle for a participating provider's billing contact.
# Example format only: @hospital-billing-agent
RELAY_PROVIDER_HANDLE=
# Patient's Relay handle for an eventual final notification.
# Example format only: @patient-agent
RELAY_PATIENT_HANDLE=
# OpenAI API key for optional narrative generation; deterministic summaries work without it.
OPENAI_API_KEY=
# Optional model for demo summary text. Defaults to gpt-4.1-mini when a key is supplied.
OPENAI_MODEL=gpt-4.1-mini

# Synthetic statement delivery: auto (default) or manual for the text inbox demo.
DEMO_BILL_DELIVERY=auto
# Photon Spectrum credentials stay server-side; calls/messages are not enabled yet.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Required before verifying native inbound Photon webhooks.
SPECTRUM_WEBHOOK_SECRET=
# Project-owned iMessage line used as SIP caller ID; approved demo destination needed separately.
SPECTRUM_VOICE_LINE=
# Dedicated bearer token for worker-only routes (/api/integrations/tick, local-intake, photon
# recovery). Never reuse a Spectrum/Nessie/FinchNode credential here. Generate 32+ random bytes,
# e.g. `openssl rand -hex 32`, and never commit the real value.
GUARDIAN_WORKER_TOKEN=
# Loopback-only base URL the worker scripts poll/forward to; do not point this at a public host.
GUARDIAN_LOCAL_URL=http://127.0.0.1:3000
# Enables the operator-only /api/cases/[id]/photon rehearsal route and the standalone receiver
# script's send path. Keep false until an explicit, authorized text rehearsal is underway.
PHOTON_DEMO_TEXTS=false
# Opt-in: after a text from DEMO_PATIENT_PHONE starts (or fails to resolve) an investigation, send
# ONE short fixed reply to that phone. Also needs PHOTON_DEMO_TEXTS=true. Off by default.
PHOTON_REPLY_TEXTS=false
# Opt-in: text DEMO_PATIENT_PHONE once at each milestone (records found, bill requested, bill
# analyzed, hospital contacted, outcome, refund). Also needs PHOTON_DEMO_TEXTS=true. Off by default.
PHOTON_UPDATE_TEXTS=false

# Comma-separated hostnames the agent may download hospital-texted bill PDFs from (exact match,
# https only). Empty rejects every link. Example format only: bills.example.org
GUARDIAN_BILL_HOSTS=
# Rehearsal only: also allow a plain-http loopback host that is listed above. Keep false otherwise.
GUARDIAN_BILL_ALLOW_LOCALHOST=false
# Pause between per-charge reading steps so a person can watch them appear (milliseconds).
GUARDIAN_READING_PACE_MS=450

# Explicitly approved demo destinations; do not commit actual phone numbers.
DEMO_HOSPITAL_PHONE=
DEMO_PATIENT_PHONE=
SPECTRUM_HOSPITAL_USER_ID=
SPECTRUM_HOSPITAL_ASSIGNED_LINE=
SPECTRUM_PATIENT_USER_ID=
SPECTRUM_PATIENT_ASSIGNED_LINE=

# Fish Audio published agent, used only for an explicitly authorized demo call (see docs/FISH_AGENT_PROMPT.md).
# The call is placed only when ALL four FISH_* values are set; otherwise the mock flow runs unchanged.
FISH_API_KEY=
FISH_AGENT_ID=
FISH_PHONE_NUMBER_ID=
# Optional second published agent that disputes the flagged charge on a real call (docs/FISH_REVIEW_AGENT_PROMPT.md).
# Unset: the billing review stays the rehearsed script.
FISH_REVIEW_AGENT_ID=
# Consenting teammate role-playing hospital billing, E.164. Must equal DEMO_HOSPITAL_PHONE.
FISH_TEST_TO_NUMBER=

# Read-only Fish PDF-receipt tool. Dedicated bearer token; never reuse worker/API secrets.
FISH_RECEIPT_TOKEN=
# HTTPS URL of the narrow receipt bridge, including /bill-receipt.
FISH_RECEIPT_URL=

# Optional read-only conversational iMessage layer (test branch).
PHOTON_CONVERSATIONAL=false
